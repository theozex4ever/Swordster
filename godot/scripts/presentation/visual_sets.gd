class_name VisualSets
extends RefCounted
## The presentation settings that choose which replaceable visual scenes a run is drawn with (ADR 0003). A visual
## set names one scene per kind of view; gameplay never sees which set is in use. `placeholder` is the shipped
## look and the default. `textured` swaps the player actor and the spirit swords for texture-based placeholder art
## (godot/art/placeholder, regenerated by tools/godot/gen_placeholder_art.gd) and keeps the drawn enemies.
## Asked for at launch with `--visuals=textured` or `?visuals=textured` (see LaunchOptions); anything else, or
## nothing, keeps the default. How to add a set of your own: docs/art/replacing-visuals.md.

const PLACEHOLDER: String = "placeholder"
const TEXTURED: String = "textured"
const DEFAULT: String = PLACEHOLDER

const _SCENES: Dictionary = {
	PLACEHOLDER: {
		"actor": "res://scenes/placeholder_actor.tscn",
		"sword": "res://scenes/placeholder_sword.tscn",
		"enemy": "res://scenes/placeholder_enemy.tscn",
	},
	TEXTURED: {
		"actor": "res://scenes/textured_actor.tscn",
		"sword": "res://scenes/textured_sword.tscn",
		"enemy": "res://scenes/placeholder_enemy.tscn",
	},
}


static func ids() -> Array[String]:
	var found: Array[String] = []
	for id: String in _SCENES:
		found.append(id)
	return found


## The set a launch value asks for: a known id as given (any case), otherwise the default.
static func resolve(requested: String) -> String:
	var id: String = requested.strip_edges().to_lower()
	return id if _SCENES.has(id) else DEFAULT


## The scene (an `actor`, `sword` or `enemy` view) of a set.
static func scene_path(id: String, kind: String) -> String:
	return String((_SCENES[resolve(id)] as Dictionary)[kind])


## Points the arena's replaceable visuals at the requested set. The default set changes nothing, so scenes a check
## or an editor already swapped in stay as they are.
static func apply(requested: String, main: Main) -> void:
	var id: String = resolve(requested)
	if id == DEFAULT:
		return
	main.actor_visual = load(scene_path(id, "actor")) as PackedScene
	main.sword_visual = load(scene_path(id, "sword")) as PackedScene
	main.enemy_visual = load(scene_path(id, "enemy")) as PackedScene
