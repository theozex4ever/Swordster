class_name SfxBank
extends Node
## Plays the baked sound effects: the prototype's fourteen (tick, slash, pierce, boom, thud, whoosh, heave, hurt,
## pop, chime, dash, gong, parry, shot), each played where the prototype plays it, and the four interface sounds
## the port added (unlock, pause, resume, restart). The files are generated by `tools/godot/gen_audio.py` and
## nothing here synthesizes anything. Browsers keep audio locked until the first click/tap/key; `unlock()` is
## called on that gesture and everything before it is intentionally silent. Like the prototype, the same sound is
## not restarted within `MIN_GAP_MS` of itself so a crowd of hits cannot machine-gun, but two different sounds,
## and a sound that is still ringing out, overlap freely (`POLYPHONY` instances of each at most).

const MIN_GAP_MS: int = 40
const POLYPHONY: int = 4
## Every sound by name, in the order the prototype lists them, then the interface sounds.
const SOUNDS: Dictionary = {
	"tick": preload("res://audio/sfx_tick.wav"),
	"slash": preload("res://audio/sfx_slash.wav"),
	"pierce": preload("res://audio/sfx_pierce.wav"),
	"boom": preload("res://audio/sfx_boom.wav"),
	"thud": preload("res://audio/sfx_thud.wav"),
	"whoosh": preload("res://audio/sfx_whoosh.wav"),
	"heave": preload("res://audio/sfx_heave.wav"),
	"hurt": preload("res://audio/sfx_hurt.wav"),
	"pop": preload("res://audio/sfx_pop.wav"),
	"chime": preload("res://audio/sfx_chime.wav"),
	"dash": preload("res://audio/sfx_dash.wav"),
	"gong": preload("res://audio/sfx_gong.wav"),
	"parry": preload("res://audio/sfx_parry.wav"),
	"shot": preload("res://audio/sfx_shot.wav"),
	"unlock": preload("res://audio/sfx_unlock.wav"),
	"pause": preload("res://audio/sfx_pause.wav"),
	"resume": preload("res://audio/sfx_resume.wav"),
	"restart": preload("res://audio/sfx_restart.wav"),
}

var unlocked: bool = false
## Sounds actually started; lets headless checks observe playback.
var played: Array[String] = []

var _players: Dictionary = {}
var _last_ms: Dictionary = {}


func _ready() -> void:
	for sound: String in SOUNDS:
		var player: AudioStreamPlayer = AudioStreamPlayer.new()
		player.stream = SOUNDS[sound]
		player.max_polyphony = POLYPHONY
		add_child(player)
		_players[sound] = player


func unlock() -> void:
	if unlocked:
		return
	unlocked = true
	play("unlock")


func play(sound: String) -> void:
	if not unlocked:
		return
	var player: AudioStreamPlayer = _players.get(sound)
	if player == null:
		return
	var now: int = Time.get_ticks_msec()
	if now - int(_last_ms.get(sound, -1000)) <= MIN_GAP_MS:
		return
	_last_ms[sound] = now
	played.append(sound)
	if played.size() > 512:
		played = played.slice(256)
	player.play()


## The sound a sword type's normal blow makes (the prototype's `SWORD_TYPES[...]["sound"]`).
static func blow_sound(type_id: StringName) -> String:
	match type_id:
		SwordDefs.WARDEN:
			return "slash"
		SwordDefs.PIKE:
			return "pierce"
		SwordDefs.COLOSSUS:
			return "boom"
		_:
			return "tick"


## The sound a sword makes as it starts an attack (`Sword.strike`): a whoosh, and a heave for a Colossus's slam.
static func strike_sound(type_id: StringName) -> String:
	return "heave" if type_id == SwordDefs.COLOSSUS else "whoosh"


## The sound a sword makes as its ultimate begins (`Sword.begin_ult`): a Fang's flurry dashes, a Warden whirls
## with a whoosh, a Pike aiming and a Colossus rising heave.
static func ultimate_sound(type_id: StringName) -> String:
	match type_id:
		SwordDefs.WARDEN:
			return "whoosh"
		SwordDefs.PIKE, SwordDefs.COLOSSUS:
			return "heave"
		_:
			return "dash"


## Maps simulation cues to sounds, one for one with the prototype's `sfx.play` calls.
func play_cue(cue: SimCue) -> void:
	match cue.kind:
		SimCue.Kind.ENEMY_HIT:
			# `hit_enemy`: a normal blow rings with its sword type's own sound; a Fang's heavy dart ticks (the flurry's
			# own `tick`); every blow, heavy or not, lands with a thud.
			if cue.spec != null and not cue.heavy:
				play(blow_sound(cue.spec.type_id))
			elif cue.spec != null and cue.spec.type_id == SwordDefs.FANG:
				play("tick")
			play("thud")
		SimCue.Kind.WALL_SLAM:
			play("thud")
		SimCue.Kind.SWORD_STRIKE:
			if cue.spec != null:
				play(strike_sound(cue.spec.type_id))
		SimCue.Kind.ENEMY_KILLED:
			play("pop")
		SimCue.Kind.PLAYER_HURT:
			play("hurt")
		SimCue.Kind.DASH:
			play("dash")
		SimCue.Kind.ULTIMATE_STARTED:
			if cue.spec != null:
				play(ultimate_sound(cue.spec.type_id))
		SimCue.Kind.WAVE_STARTED:
			play("gong")
		SimCue.Kind.SWORD_SWAPPED:
			play("chime")
		SimCue.Kind.PROJECTILE_FIRED:
			play("shot")
		SimCue.Kind.PROJECTILE_PARRIED:
			play("parry")
		SimCue.Kind.ENEMY_FROZEN:
			play("parry")
		SimCue.Kind.MAELSTROM_BEAT:
			if cue.amount > 0:
				play("slash")
		SimCue.Kind.MAELSTROM_BURST:
			play("slash")
		SimCue.Kind.SKEWER_LAUNCHED:
			play("pierce")
		SimCue.Kind.COLOSSUS_SLAM:
			play("boom")
		SimCue.Kind.CONVERGE:
			play("chime")
		_:
			pass
